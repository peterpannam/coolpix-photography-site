---
import Layout from '../layouts/Layout.astro';
import MapGallery from '../components/MapGallery.astro';
import { placeOnJourney } from '../lib/map/locate';
import type { Journey, PlaceInput } from '../lib/map/types';
import { fmtKm } from '../lib/map/format';
import journeyData from '../data/journey.json';
import samplePlaces from '../data/sample-places.json';

const journey = journeyData as unknown as Journey;
// Sample landmarks along the route until the Sanity photo documents exist; swap in a query that returns
// { name, lon, lat, photos, print, story, storyHref, printHref, images } for each place.
const places = placeOnJourney(samplePlaces as PlaceInput[], journey);
---

<Layout title="Walkabout">
  <div class="page">
    <header class="tp-nav">
      <a class="tp-nav__logo" href="/">Walkabout</a>
      <span class="tp-label">{fmtKm(journey.totalKm)} km around Australia</span>
    </header>
    <main class="page-main">
      <MapGallery places={places} sample />
    </main>
  </div>
</Layout>

<style>
  .page {
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .page-main {
    display: grid;
    min-height: 0;
  }
  @media (max-width: 720px) {
    .page :global(.tp-nav) {
      padding: 12px 16px;
    }
    .page :global(.tp-nav__logo) {
      font-size: var(--tp-text-xl);
    }
  }
</style>
